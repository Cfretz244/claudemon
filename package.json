{
  "name": "claudemon",
  "version": "1.0.0",
  "description": "A Pokemon Yellow recreation built entirely by Claude",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/run.mjs",
    "engine:build": "npm run build --workspace @claudemon/engine",
    "engine:check": "npm run engine:build && node packages/engine/scripts/check.mjs && node scripts/check-engine-package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@claudemon/engine": "*",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "midi-file": "^1.2.4",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
